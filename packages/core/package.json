{
  "name": "@q/core",
  "version": "0.0.0",
  "private": true,
  "description": "Business logic as a modular monolith: session, transcript, agent, program, session-runtime. Services are the public interface; repositories are private.",
  "type": "module",
  "exports": {
    "./agent/agent-service": "./src/agent/agent-service.ts",
    "./program/command": "./src/program/command.ts",
    "./program/message": "./src/program/message.ts",
    "./program/program": "./src/program/program.ts",
    "./program/subscription": "./src/program/subscription.ts",
    "./program/update": "./src/program/update.ts",
    "./session/current-session": "./src/session/current-session.ts",
    "./session/session-service": "./src/session/session-service.ts",
    "./session-runtime/session-runtime-service": "./src/session-runtime/session-runtime-service.ts",
    "./transcript/transcript-service": "./src/transcript/transcript-service.ts"
  },
  "dependencies": {
    "@effect/ai-anthropic": "4.0.0-rc.115",
    "@q/config": "workspace:*",
    "@q/domain": "workspace:*",
    "@q/kit": "workspace:*",
    "effect": "4.0.0-rc.115",
    "effect-ai-ui": "workspace:*"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.0-rc.115",
    "@q/factories": "workspace:*",
    "@q/test": "workspace:*"
  }
