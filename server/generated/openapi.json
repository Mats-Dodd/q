    "/sessions/{id}/stream": {
      "get": {
        "tags": [
          "sessionStream"
        ],
        "operationId": "sessionStream.read",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "schema": {
              "$ref": "#/components/schemas/SessionId"
            },
            "required": true
          },
          {
            "name": "if-none-match",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "required": false
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/ReadFrom"
            },
            "required": false
          },
          {
            "name": "live",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "sse"
              ]
            },
            "required": false
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "required": false
          }
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "StreamChunks",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StreamChunks"
                }
              },
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/StreamEvent"
                },
                "x-effect-stream": {
                  "encoding": "sse",
                  "causeSchema": {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "_tag": {
                              "type": "string",
                              "enum": [
                                "Fail"
                              ]
                            },
                            "error": {
                              "not": {}
                            }
                          },
                          "required": [
                            "_tag",
                            "error"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "_tag": {
                              "type": "string",
                              "enum": [
                                "Die"
                              ]
                            },
                            "defect": {}
                          },
                          "required": [
                            "_tag",
                            "defect"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "_tag": {
                              "type": "string",
                              "enum": [
                                "Interrupt"
                              ]
                            },
                            "fiberId": {
                              "anyOf": [
                                {
                                  "type": "number"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            }
                          },
                          "required": [
                            "_tag",
                            "fiberId"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "errorSchema": {
                    "not": {}
                  },
                  "failureEvent": "effect/http-api/stream/failure"
                }
              }
            },
            "headers": {
              "stream-next-offset": {
                "schema": {
                  "$ref": "#/components/schemas/Offset"
                },
                "required": true
              },
              "cache-control": {
                "schema": {
                  "type": "string"
                },
                "required": true
              },
              "stream-up-to-date": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "required": true
              },
              "etag": {
                "schema": {
                  "type": "string"
                },
                "required": false
              }
            }
          },
          "400": {
            "description": "RequestInvalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestInvalid"
                }
              }
            }
          },
          "404": {
            "description": "SessionNotFound",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionNotFound"
                }
              }
            }
          },
          "500": {
            "description": "InternalServerError"
          }
        }
      },
      "head": {
        "tags": [
          "sessionStream"
        ],
        "operationId": "sessionStream.metadata",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "schema": {
              "$ref": "#/components/schemas/SessionId"
            },
            "required": true
