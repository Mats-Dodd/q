  "components": {
    "schemas": {
      "RequestInvalid": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": [
              "RequestInvalid"
            ]
          },
          "location": {
            "type": "string",
            "enum": [
              "Params",
              "Headers",
              "Query",
              "Payload"
            ]
          },
          "message": {
            "type": "string"
          },
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RequestIssue"
            }
          }
        },
        "required": [
          "_tag",
          "location",
          "message",
          "issues"
        ],
        "additionalProperties": false
      },
      "RequestIssue": {
        "type": "object",
        "properties": {
          "path": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            }
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "message"
        ],
        "additionalProperties": false
      },
      "NothingToCancel": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": [
              "NothingToCancel"
            ]
          },
          "sessionId": {
            "$ref": "#/components/schemas/SessionId"
          }
        },
        "required": [
          "_tag",
          "sessionId"
        ],
        "additionalProperties": false
      },
      "SessionId": {
        "type": "string",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
        "format": "uuid"
      },
      "SessionBusy": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": [
              "SessionBusy"
            ]
          },
          "sessionId": {
            "$ref": "#/components/schemas/SessionId"
          }
        },
        "required": [
          "_tag",
          "sessionId"
        ],
        "additionalProperties": false
      },
      "SessionNotFound": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": [
              "SessionNotFound"
            ]
          },
          "id": {
            "$ref": "#/components/schemas/SessionId"
          }
        },
        "required": [
          "_tag",
          "id"
        ],
        "additionalProperties": false
      },
      "Delivery": {
        "type": "object",
        "properties": {
          "turnId": {
            "$ref": "#/components/schemas/TurnId"
          },
          "disposition": {
            "type": "string",
            "enum": [
              "started"
            ]
          }
        },
        "required": [
          "turnId",
          "disposition"
        ],
        "additionalProperties": false
      },
      "TurnId": {
        "type": "string",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
        "format": "uuid"
      },
      "SendMessage": {
        "type": "object",
        "properties": {
          "messageId": {
            "$ref": "#/components/schemas/MessageId"
          },
          "text": {
            "$ref": "#/components/schemas/MessageText"
          }
        },
        "required": [
          "messageId",
          "text"
        ],
        "additionalProperties": false
      },
      "MessageText": {
        "type": "string",
        "minLength": 1
      },
      "MessageId": {
        "type": "string",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
        "format": "uuid"
      },
      "Offset": {
        "type": "string"
      },
      "StreamEvent": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/StreamDataEvent"
          },
          {
            "$ref": "#/components/schemas/StreamControlEvent"
          }
        ]
      },
      "StreamControlEvent": {
        "type": "object",
        "properties": {
          "event": {
            "type": "string",
            "enum": [
              "control"
            ]
          },
          "data": {
            "$ref": "#/components/schemas/StreamControlJson"
          }
        },
        "required": [
          "event",
          "data"
        ],
        "additionalProperties": false
      },
      "StreamControlJson": {
        "type": "string",
        "contentMediaType": "application/json"
      },
      "StreamDataEvent": {
        "type": "object",
        "properties": {
          "event": {
            "type": "string",
            "enum": [
              "data"
            ]
          },
          "data": {
            "$ref": "#/components/schemas/StreamChunksJson"
          }
        },
        "required": [
          "event",
          "data"
        ],
        "additionalProperties": false
      },
      "StreamChunksJson": {
        "type": "string",
        "contentMediaType": "application/json"
      },
      "StreamChunks": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/StreamChunk"
        }
      },
      "StreamChunk": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/StartChunk"
          },
          {
            "$ref": "#/components/schemas/FinishChunk"
          },
          {
            "$ref": "#/components/schemas/AbortChunk"
          },
          {
            "$ref": "#/components/schemas/MessageMetadataChunk"
          },
          {
            "$ref": "#/components/schemas/ErrorChunk"
          },
          {
            "$ref": "#/components/schemas/StartStepChunk"
          },
          {
            "$ref": "#/components/schemas/FinishStepChunk"
          },
          {
            "$ref": "#/components/schemas/ResetStepChunk"
          },
          {
            "$ref": "#/components/schemas/TextStartChunk"
          },
          {
            "$ref": "#/components/schemas/TextDeltaChunk"
          },
          {
            "$ref": "#/components/schemas/TextEndChunk"
          },
          {
            "$ref": "#/components/schemas/ReasoningStartChunk"
          },
          {
            "$ref": "#/components/schemas/ReasoningDeltaChunk"
          },
          {
            "$ref": "#/components/schemas/ReasoningEndChunk"
          },
          {
            "$ref": "#/components/schemas/ToolInputStartChunk"
          },
          {
            "$ref": "#/components/schemas/ToolInputDeltaChunk"
          },
          {
            "$ref": "#/components/schemas/ToolInputAvailableChunk"
          },
          {
            "$ref": "#/components/schemas/ToolInputErrorChunk"
          },
          {
            "$ref": "#/components/schemas/ToolApprovalRequestChunk"
          },
          {
            "$ref": "#/components/schemas/ToolApprovalResponseChunk"
          },
          {
            "$ref": "#/components/schemas/ToolOutputAvailableChunk"
          },
          {
            "$ref": "#/components/schemas/ToolOutputErrorChunk"
          },
          {
            "$ref": "#/components/schemas/ToolOutputDeniedChunk"
          },
          {
            "$ref": "#/components/schemas/SourceUrlChunk"
          },
          {
            "$ref": "#/components/schemas/SourceDocumentChunk"
          },
          {
            "$ref": "#/components/schemas/FileChunk"
          },
          {
            "$ref": "#/components/schemas/ReasoningFileChunk"
          },
          {
            "$ref": "#/components/schemas/CustomChunk"
          },
          {
            "$ref": "#/components/schemas/UserMessageChunk"
          },
          {
            "$ref": "#/components/schemas/TurnStartedChunk"
          },
          {
            "$ref": "#/components/schemas/TurnEndedChunk"
          }
        ]
      },
      "TurnEndedChunk": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "data-turn-end"
            ]
          },
          "id": {
            "$ref": "#/components/schemas/TurnId"
          },
          "data": {
            "type": "object",
            "properties": {
              "reason": {
                "$ref": "#/components/schemas/TurnEndReason"
              }
            },
            "required": [
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "type",
          "id",
          "data"
        ],
        "additionalProperties": false
      },
      "TurnEndReason": {
        "type": "string",
        "enum": [
          "completed",
          "cancelled",
          "failed"
        ]
      },
      "TurnStartedChunk": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "data-turn-start"
            ]
          },
          "id": {
            "$ref": "#/components/schemas/TurnId"
          },
          "data": {
            "type": "object",
            "properties": {
              "model": {
                "type": "string"
              }
            },
            "required": [
              "model"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "type",
          "id",
          "data"
        ],
        "additionalProperties": false
      },
      "UserMessageChunk": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "data-user-message"
            ]
          },
          "id": {
            "$ref": "#/components/schemas/TurnId"
          },
          "data": {
            "type": "object",
            "properties": {
              "text": {
                "$ref": "#/components/schemas/MessageText"
              }
            },
            "required": [
              "text"
            ],
            "additionalProperties": false
